{
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/projects/apps/gaffer-iq",
      "destination": "/projects/apps/gaffer-iq/",
      "permanent": true
    },
    {
      "source": "/projects/apps/f1live",
      "destination": "/projects/apps/f1live/",
      "permanent": true
    },
    {
      "source": "/projects/apps/fc26-calculator",
      "destination": "/projects/apps/fc26-calculator/",
      "permanent": true
    },
    {
      "source": "/projects/wiki",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/projects/wiki/",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/projects/wiki/f1live",
      "destination": "/projects/",
      "permanent": false
    },
    {
      "source": "/projects/wiki/f1live/:path*",
      "destination": "/projects/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/projects/apps/gaffer-iq/",
      "destination": "https://gaffer-iq-project-try2.vercel.app/"
    },
    {
      "source": "/projects/apps/gaffer-iq/:path*",
      "destination": "https://gaffer-iq-project-try2.vercel.app/:path*"
    },
    {
      "source": "/projects/apps/f1live/",
      "destination": "https://f1-live-alpha.vercel.app/"
    },
    {
      "source": "/projects/apps/f1live/:path*",
      "destination": "https://f1-live-alpha.vercel.app/:path*"
    },
    {
      "source": "/projects/apps/fc26-calculator/",
      "destination": "https://jayjaybee-site-fc26-calculator.vercel.app/"
    },
    {
      "source": "/projects/apps/fc26-calculator/:path*",
      "destination": "https://jayjaybee-site-fc26-calculator.vercel.app/:path*"
    }
  ]
}
